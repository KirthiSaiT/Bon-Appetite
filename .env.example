# Copy to .env.local and fill in.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_ADMIN_EMAIL=admin.bonappetit@gmail.com

# Razorpay publishable key id — safe for the browser (checkout needs it).
VITE_RAZORPAY_KEY_ID=rzp_test_...

# Optional: dedicated EmailJS template id for the customer TICKET email.
# If unset, the ticket falls back to the order template. See TICKET-EMAIL-SETUP.md.
VITE_EMAILJS_TICKET_TEMPLATE_ID=template_...

# Server-only (never prefix with VITE_)
CLERK_SECRET_KEY=sk_test_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
