# Copy to .env.local and fill in.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_ADMIN_EMAIL=admin.bonappetit@gmail.com

# Razorpay publishable key id — safe for the browser (checkout needs it).
VITE_RAZORPAY_KEY_ID=rzp_test_...

# EmailJS (public browser values; defaults are built in, set to override).
# Never put the EmailJS private key in any file the browser can read.
VITE_EMAILJS_SERVICE_ID=service_...
VITE_EMAILJS_TEMPLATE_ID=template_...
VITE_EMAILJS_PUBLIC_KEY=...

# Optional: dedicated EmailJS template id for the customer TICKET email.
# If unset, the ticket falls back to the order template. See TICKET-EMAIL-SETUP.md.
VITE_EMAILJS_TICKET_TEMPLATE_ID=template_...

# Server-only (never prefix with VITE_)
CLERK_SECRET_KEY=sk_test_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# Supabase secret key (Project Settings → API Keys → Secret keys, sb_secret_...).
# Only /api/* uses it, to look up workshop prices and save PAID bookings.
SUPABASE_SECRET_KEY=sb_secret_...

# Server-side admin email on each paid booking (Gmail SMTP). Server-only.
# Use a Gmail App Password (Google Account → Security → 2-Step Verification → App passwords), not the normal password.
SMTP_USER=admin.bonappetit@gmail.com
SMTP_PASS=
# Optional: where booking alerts go (defaults to admin.bonappetit@gmail.com)
ADMIN_NOTIFY_EMAIL=

# Easiest option: Resend API key (resend.com, sign up with admin.bonappetit@gmail.com). Server-only.
RESEND_API_KEY=

# ── Delivery charges (server-only; each is OFF until set) ──────────────
# Cafe delivery fee by road distance. Google Cloud key with the "Routes API" enabled (billing required).
GOOGLE_MAPS_API_KEY=
# Optional: override the kitchen address (or put "lat,lng" style address text)
KITCHEN_ADDRESS=
# Courier shipping via Shiprocket. Use a Shiprocket API user, not your login.
# Also fill in PACKAGES (weights and box sizes) in api/_lib/delivery.js.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_PICKUP_LOCATION=
